# Herr Claw — Example environment (.env.example)
# Copy to .env and fill in real values:  cp .env.example .env
# .env holds live secrets, is gitignored, and must never be read by agents (see AGENTS.md).

# Telegram bot token, from @BotFather (created in P0).
# Primary (sandbox-in) mode: token lives in the OpenShell gateway, NOT here —
# only put it in .env when running host-only fallback governance.
TELEGRAM_BOT_TOKEN=
# Telegram chat ID of the single allowed user (Lucas) — the only chat the bot answers
HERR_TELEGRAM_CHAT_ID=

# NVIDIA Build API key (https://build.nvidia.com) for Nemotron 3 inference on
# https://integrate.api.nvidia.com/v1. Host/gateway scope only — never exposed to agent scope.
NVIDIA_API_KEY=

# Obsidian vault root. This vault is the ONLY one in scope (~/Obsidian/vault is out of scope);
# the agent may write solely to Deutsch/, Daily notes/ and Weeks/ inside it.
HERR_VAULT=~/Documents/Lucas' Vault

# Optional model override (default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
HERR_MODEL=

# Optional inference endpoint override (default: https://integrate.api.nvidia.com/v1)
HERR_NVIDIA_BASE_URL=

# Optional: whisper model for STT in voice mode (mlx-whisper, language locked to de).
# Default: base — tiny's German accuracy is too poor; base stays real-time on Apple Silicon.
HERR_WHISPER_MODEL=

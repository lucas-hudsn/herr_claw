# Herr Claw — Example environment (.env.example)
# Copy to .env and fill in real values:  cp .env.example .env
# .env holds live secrets, is gitignored, and must never be read by agents (see AGENTS.md).

# Telegram bot token, from @BotFather.
# Scope: the OpenShell gateway holds it and resolves it at egress. In-sandbox
# processes (telegram-loop, the cron-fired job sends) only ever carry the
# gateway's `openshell:resolve:env:` placeholder — injected via the cron
# entries' --command-env, never a real value. The host .env copy is the dev/
# break-glass fallback only (host .env must stay out of the sandbox either way).
TELEGRAM_BOT_TOKEN=
# Telegram chat ID of the single allowed user (Lucas) — the only chat the bot writes to
HERR_TELEGRAM_CHAT_ID=

# NVIDIA Build API key (https://build.nvidia.com) for Nemotron 3 inference on
# https://integrate.api.nvidia.com/v1. Host/gateway scope only — never exposed to
# agent scope. Inside the sandbox the gateway-routed endpoint (inference.local)
# is used instead and the gateway injects the key at egress; no key value there.
NVIDIA_API_KEY=

# Obsidian vault root — HOST only. The vault never enters the sandbox; the
# sandboxed agent appends through the bridge's scoped vault tools. This vault
# is the ONLY one in scope (~/Obsidian/vault is out of scope); the agent may
# write solely to Deutsch/, Daily notes/ and Weeks/ inside it.
HERR_VAULT=~/Documents/Lucas' Vault

# MCP bridge endpoint (herr-claw bridge serves Apple Reminders/Calendar + the vault here).
# Empty → default http://127.0.0.1:8765/mcp; "off" disables bridge calls (chat works without it).
# Inside the NemoClaw sandbox this is set to the OpenShell host alias via the
# sandbox .env + cron entries: http://host.openshell.internal:8765/mcp
HERR_BRIDGE_URL=

# Optional: extra Host/Origin values the bridge accepts when it is reachable
# under a non-localhost name (comma-separated). Unset → SDK default (DNS
# rebinding protection off; the bridge only listens on 127.0.0.1). Set these on
# the bridge process for the sandbox-in deployment so the OpenShell host alias
# passes the MCP server's host check with an explicit allowlist:
#   HERR_BRIDGE_ALLOWED_HOSTS=host.openshell.internal:8765
#   HERR_BRIDGE_ALLOWED_ORIGINS=host.openshell.internal:8765
HERR_BRIDGE_ALLOWED_HOSTS=
HERR_BRIDGE_ALLOWED_ORIGINS=

# Sandbox the agent lives in (P5/P6; `herr-claw install-cron`, the TUI/voice
# brain path). This names the NemoClaw sandbox — it is NOT a secret.
HERR_NEMOCLAW_SANDBOX=my-assistant

# State directory override. Default: <repo>/state on the host. Inside the
# sandbox the deployment sets HERR_STATE_DIR=/sandbox/herrclaw/state — the
# brain's state (SRS, session/history/quiz, memory journal) lives WITH the
# agent (ONE state path, P6).
HERR_STATE_DIR=

# Frontend brain (P6): "sandbox" (default) ships every TUI/voice turn to the
# sandboxed agent via `nemoclaw exec`; "local" runs the brain in-process —
# break-glass when the sandbox is down (AutoBrain falls back automatically,
# this only changes the default).
HERR_CHAT_BACKEND=

# Optional model override (default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
HERR_MODEL=

# Optional inference endpoint override (default: https://integrate.api.nvidia.com/v1).
# Inside the sandbox the deployment sets the gateway-routed
# https://inference.local/v1 (key injected at egress).
HERR_NVIDIA_BASE_URL=

# Optional: whisper model for STT in voice mode (mlx-whisper, language locked to de).
# Default: base — tiny's German accuracy is too poor; base stays real-time on Apple Silicon.
HERR_WHISPER_MODEL=

# Optional: input device for voice mode (name substring or PortAudio index).
# Empty → auto: the system default input if it is a real mic, else the first
# real one — iPhone/iPad Continuity mics are always skipped unless named here
# (P0 finding: they return pure digital silence). Example: HERR_MIC_DEVICE=MacBook
HERR_MIC_DEVICE=

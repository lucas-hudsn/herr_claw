# Herr Claw — Example environment (.env.example)
# Copy to .env and fill in real values:  cp .env.example .env
# .env holds live secrets, is gitignored, and must never be read by agents (see AGENTS.md).

# Telegram bot token, from @BotFather (created in P0).
# Primary (sandbox-in) mode: token lives in the OpenShell gateway, NOT here —
# only put it in .env when running host-only fallback governance.
TELEGRAM_BOT_TOKEN=
# Telegram chat ID of the single allowed user (Lucas) — the only chat the bot answers
HERR_TELEGRAM_CHAT_ID=

# NVIDIA Build API key (https://build.nvidia.com) for Nemotron 3 inference on
# https://integrate.api.nvidia.com/v1. Host/gateway scope only — never exposed to agent scope.
NVIDIA_API_KEY=

# Obsidian vault root. This vault is the ONLY one in scope (~/Obsidian/vault is out of scope);
# the agent may write solely to Deutsch/, Daily notes/ and Weeks/ inside it.
HERR_VAULT=~/Documents/Lucas' Vault

# MCP bridge endpoint (herr-claw bridge serves Apple Reminders/Calendar + the vault here).
# Empty → default http://127.0.0.1:8765/mcp; "off" disables bridge calls (chat works without it).
# Inside the NemoClaw sandbox (OpenClaw-cron trigger path) this is set to the
# OpenShell host alias via the cron entry: http://host.openshell.internal:8765/mcp
HERR_BRIDGE_URL=

# Optional: extra Host/Origin values the bridge accepts when it is reachable
# under a non-localhost name (comma-separated). Unset → SDK default (DNS
# rebinding protection off; the bridge only listens on 127.0.0.1). Set these on
# the bridge process for the sandbox-in deployment so the OpenShell host alias
# passes the MCP server's host check with an explicit allowlist:
#   HERR_BRIDGE_ALLOWED_HOSTS=host.openshell.internal:8765
#   HERR_BRIDGE_ALLOWED_ORIGINS=host.openshell.internal:8765
HERR_BRIDGE_ALLOWED_HOSTS=
HERR_BRIDGE_ALLOWED_ORIGINS=

# Sandbox the OpenClaw-cron scheduler lives in (P5; `herr-claw daemon --install-cron`).
# This names the NemoClaw sandbox — it is NOT a secret.
HERR_NEMOCLAW_SANDBOX=my-assistant

# Optional model override (default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
HERR_MODEL=

# Optional inference endpoint override (default: https://integrate.api.nvidia.com/v1)
HERR_NVIDIA_BASE_URL=

# Optional: whisper model for STT in voice mode (mlx-whisper, language locked to de).
# Default: base — tiny's German accuracy is too poor; base stays real-time on Apple Silicon.
HERR_WHISPER_MODEL=

# Optional: input device for voice mode (name substring or PortAudio index).
# Empty → auto: the system default input if it is a real mic, else the first
# real one — iPhone/iPad Continuity mics are always skipped unless named here
# (P0 finding: they return pure digital silence). Example: HERR_MIC_DEVICE=MacBook
HERR_MIC_DEVICE=
